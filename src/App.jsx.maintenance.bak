import React, { useState, useEffect } from 'react';

export default function App() {
  const [isAdminLoggedIn, setIsAdminLoggedIn] = useState(false);
  const [adminPassword, setAdminPassword] = useState('');
  const [isAdminOpen, setIsAdminOpen] = useState(false);

  // AI Models admin state
  const [adminAiModel, setAdminAiModel] = useState('openai');
  const [adminOpenAiKey, setAdminOpenAiKey] = useState('');
  const [adminGeminiKey, setAdminGeminiKey] = useState('');
  const [adminClaudeKey, setAdminClaudeKey] = useState('');
  const [configSuccessMsg, setConfigSuccessMsg] = useState('');

  useEffect(() => {
    if (isAdminLoggedIn) {
      fetch('/api/config/ai?password=alacor2026')
        .then(res => res.json())
        .then(data => {
          if (data) {
            setAdminAiModel(data.activeModel || 'openai');
            setAdminOpenAiKey(data.openaiKey || '');
            setAdminGeminiKey(data.geminiKey || '');
            setAdminClaudeKey(data.claudeKey || '');
          }
        })
        .catch(err => console.error('Error fetching AI config:', err));
    }
  }, [isAdminLoggedIn]);

  const handleAdminLogin = (e) => {
    e.preventDefault();
    if (adminPassword === 'alacor2026') {
      setIsAdminLoggedIn(true);
    } else {
      alert('Contraseña incorrecta');
    }
  };

  const handleSaveAiConfig = async (e) => {
    e.preventDefault();
    try {
      const res = await fetch('/api/config/ai', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-admin-password': 'alacor2026'
        },
        body: JSON.stringify({
          activeModel: adminAiModel,
          openaiKey: adminOpenAiKey,
          geminiKey: adminGeminiKey,
          claudeKey: adminClaudeKey
        })
      });
      const data = await res.json();
      if (data.success) {
        setConfigSuccessMsg('Configuración de IA guardada exitosamente.');
        setTimeout(() => setConfigSuccessMsg(''), 3000);
      } else {
        alert('Error: ' + data.error);
      }
    } catch (err) {
      alert('Error de conexión al guardar configuración de IA.');
    }
  };

  return (
    <div className="bg-black min-h-screen text-white font-sans flex items-center justify-center">
      <div className="text-center max-w-lg">
        <h1 className="text-3xl font-bold text-yellow-500 mb-4">Mantenimiento Crítico - ALACOR S.A.S.</h1>
        <p className="text-gray-400 mb-8">El sistema de chat y catálogo se encuentra fuera de línea debido a una actualización mayor de Inteligencia Artificial.</p>
        <button onClick={() => setIsAdminOpen(true)} className="bg-white/10 hover:bg-white/20 px-4 py-2 rounded">
          Acceso Administrador (Configuración IA)
        </button>
      </div>

      {isAdminOpen && (
        <div className="fixed inset-0 bg-black/90 z-50 overflow-y-auto p-4 flex items-center justify-center">
          <div className="w-full max-w-md bg-gray-900 rounded-xl border border-white/10 p-6 relative">
            <button onClick={() => setIsAdminOpen(false)} className="absolute top-4 right-4 text-gray-400 hover:text-white">?</button>

            {!isAdminLoggedIn ? (
              <form onSubmit={handleAdminLogin} className="mt-4">
                <h2 className="text-xl font-bold mb-4">Autenticación</h2>
                <input 
                  type="password" 
                  value={adminPassword}
                  onChange={e => setAdminPassword(e.target.value)}
                  placeholder="Contraseña"
                  className="w-full bg-black/50 border border-white/10 rounded px-4 py-2 mb-4 text-white"
                />
                <button type="submit" className="w-full bg-yellow-500 text-black font-bold py-2 rounded">
                  Entrar
                </button>
              </form>
            ) : (
              <div className="mt-4">
                <h2 className="text-xl font-bold text-yellow-500 mb-4">Configuración de IA (LLM)</h2>
                {configSuccessMsg && <p className="text-green-400 text-xs mb-4">{configSuccessMsg}</p>}
                <form onSubmit={handleSaveAiConfig} className="space-y-4">
                  <div>
                    <label className="block text-xs mb-1">Motor de IA Activo</label>
                    <select 
                      value={adminAiModel}
                      onChange={e => setAdminAiModel(e.target.value)}
                      className="w-full bg-black/50 border border-white/10 rounded p-2 text-white"
                    >
                      <option value="openai">OpenAI</option>
                      <option value="gemini">Google Gemini</option>
                      <option value="claude">Anthropic Claude</option>
                    </select>
                  </div>
                  {adminAiModel === 'openai' && (
                    <input type="password" placeholder="OpenAI API Key" value={adminOpenAiKey} onChange={e => setAdminOpenAiKey(e.target.value)} className="w-full bg-black border border-white/10 p-2 rounded text-white" />
                  )}
                  {adminAiModel === 'gemini' && (
                    <input type="password" placeholder="Gemini API Key" value={adminGeminiKey} onChange={e => setAdminGeminiKey(e.target.value)} className="w-full bg-black border border-white/10 p-2 rounded text-white" />
                  )}
                  {adminAiModel === 'claude' && (
                    <input type="password" placeholder="Claude API Key" value={adminClaudeKey} onChange={e => setAdminClaudeKey(e.target.value)} className="w-full bg-black border border-white/10 p-2 rounded text-white" />
                  )}
                  <button type="submit" className="w-full bg-yellow-500 text-black font-bold py-2 rounded">Guardar Credenciales</button>
                </form>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
